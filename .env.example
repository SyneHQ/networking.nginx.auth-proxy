# Copy to .env and provide real values outside version control.
JWT_SECRET='replace-with-a-secret-managed-outside-git'
JWT_SALT='authjs.session-token'

# Expiration is always required. Leave issuer/audience blank unless Auth.js tokens
# are configured to issue matching claims; when set, both claims are enforced.
TOKEN_ISSUER=''
TOKEN_AUDIENCE=''

# Never enable this outside a local direct-loopback development environment. The
# header value must be a non-empty local secret and no identity is propagated.
ALLOW_LOCAL_BYPASS='false'
LOCAL_BYPASS_HEADER='X-Local-Auth-Bypass'
LOCAL_BYPASS_VALUE=''

# No database verifier is configured in this proxy. Keep disabled until one exists.
ENABLE_DB_CHECK='false'
